    "first_paragraph": "Turn a pile of sales or customer calls into an account timeline, evidence checked observations, and a coaching report. Start with transcripts from any source. Calls without recordings stay in the timeline so gaps remain visible.",
    "code_blocks": [
      {
        "line": 14,
        "lang": "bash",
        "text": "git clone https://github.com/rader-ai/sales-call-review.git\ncd sales-call-review\npython3 run.py demo\nopen workspace/report.html           # macOS\n# xdg-open workspace/report.html     # Linux"
      },
      {
        "line": 30,
        "lang": "bash",
        "text": "python3 run.py init\npython3 run.py add \\\n  --account \"Example Account\" --id \"discovery-01\" \\\n  --date \"2026-01-12\" --title \"Discovery\" \\\n  --internal \"Rep Name\" --external \"Buyer Name\" \\\n  --transcript /path/to/reviewed-transcript.md\npython3 run.py report"
      },
      {
        "line": 50,
        "lang": "bash",
        "text": "python3 run.py transcribe --media /path/to/call.mp4 \\\n  --model /path/to/ggml-model.bin \\\n  --output /path/to/call.txt --language en --threads 4"
      }
